<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Greens & Yellows</title>
<style>
body { font-family: Arial; text-align:center; margin-top:40px; }
input { font-size:20px; text-transform:uppercase; }
button { font-size:18px; margin-left:5px; }
#log { margin-top:20px; white-space:pre-line; }
table { margin:20px auto; border-collapse:collapse; }
td,th { border:1px solid #aaa; padding:6px 12px; }
</style>
</head>
<body>

<h1>Greens & Yellows</h1>
<p>Guess the 6-letter word in <b>20</b> tries.</p>

<input id="guessBox" maxlength="6">
<button onclick="submitGuess()">Guess</button>

<div id="status"></div>
<div id="log"></div>

<h3>Stats</h3>
<div id="stats"></div>

<h3>Leaderboard (Local)</h3>
<input id="nameBox" placeholder="username">
<button onclick="saveScore()">Save Score</button>
<table id="board"></table>

<script>
let words = [];
let secret = "";
let guessCount = 1;
let maxGuesses = 20;
let finished = false;

async function loadWords(){
    let res = await fetch("bnc 6-letter 23033.txt");
    let text = await res.text();
    words = text.split(/\r?\n/).map(w=>w.trim()).filter(Boolean);
    startGame();
}

function getDailyIndex(){
    let start = new Date(2024,0,1);
    let now = new Date();
    let diff = Math.floor((now-start)/86400000);
    return diff % words.length;
}

function startGame(){
    secret = words[getDailyIndex()];
    guessCount = 1;
    finished = false;
    document.getElementById("log").textContent="";
    document.getElementById("status").textContent="Daily word loaded.";
}

function greenYellow(guess){
    let greens=0,yellows=0;
    let gList=secret.split("");
    let wList=guess.split("");
    let remG=[], remW=[];

    for(let i=0;i<6;i++){
        if(gList[i]===wList[i]) greens++;
        else{
            remG.push(gList[i]);
            remW.push(wList[i]);
        }
    }

    for(let g of remG){
        let i=remW.indexOf(g);
        if(i!=-1){ yellows++; remW.splice(i,1); }
    }
    return `${greens} Greens, ${yellows} Yellows.`;
}

function submitGuess(){
    if(finished) return;

    let box=document.getElementById("guessBox");
    let guess=box.value.toUpperCase();
    box.value="";

    if(guess.length!==6){ setStatus("Enter 6 letters."); return; }
    if(!words.includes(guess)){ setStatus("Invalid word."); return; }

    let result=greenYellow(guess);
    log(`Guess ${guessCount}: ${guess} → ${result}`);

    if(guess===secret){
        log("YOU WIN!");
        recordResult(true);
        finished=true;
        return;
    }

    guessCount++;
    if(guessCount>maxGuesses){
        log(`YOU LOSE! Word was ${secret}`);
        recordResult(false);
        finished=true;
    }
}

function log(t){ document.getElementById("log").textContent+=t+"\n"; }
function setStatus(t){ document.getElementById("status").textContent=t; }

function recordResult(win){
    let stats=JSON.parse(localStorage.getItem("gyStats")||'{"wins":0,"losses":0}');
    if(win) stats.wins++; else stats.losses++;
    localStorage.setItem("gyStats",JSON.stringify(stats));
    updateStats();
}

function updateStats(){
    let s=JSON.parse(localStorage.getItem("gyStats")||'{"wins":0,"losses":0}');
    let total=s.wins+s.losses;
    let rate= total? ((s.wins/total)*100).toFixed(1):0;
    document.getElementById("stats").textContent=
        `Wins: ${s.wins} | Losses: ${s.losses} | Win Rate: ${rate}%`;
}

function saveScore(){
    if(!finished){ alert("Finish game first"); return; }
    let name=document.getElementById("nameBox").value.trim();
    if(!name){ alert("Enter name"); return; }

    let board=JSON.parse(localStorage.getItem("gyBoard")||"[]");
    board.push({
        name:name,
        guesses:guessCount-1,
        date:new Date().toLocaleDateString()
    });

    board.sort((a,b)=>a.guesses-b.guesses);
    board=board.slice(0,10);
    localStorage.setItem("gyBoard",JSON.stringify(board));
    renderBoard();
}

function renderBoard(){
    let board=JSON.parse(localStorage.getItem("gyBoard")||"[]");
    let html="<tr><th>Name</th><th>Guesses</th><th>Date</th></tr>";
    for(let r of board)
        html+=`<tr><td>${r.name}</td><td>${r.guesses}</td><td>${r.date}</td></tr>`;
    document.getElementById("board").innerHTML=html;
}

updateStats();
renderBoard();
loadWords();
</script>

</body>
</html>
